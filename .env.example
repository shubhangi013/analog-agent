# Copy to .env (git-ignored) and fill in. Real environment variables override this file.
LLM_PROVIDER=azure_foundry
# Deployment name in your Foundry project (not the catalog model name if they differ).
LLM_MODEL=<your-deployment-name>
# Resource endpoint; /openai/v1/chat/completions is appended automatically.
AZURE_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=<your-api-key>
# Optional
LLM_TIMEOUT_S=60
# Set to 0 if the deployment rejects response_format=json_object.
LLM_JSON_MODE=1
